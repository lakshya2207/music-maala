# ==============================================================================
# Music Maala (म्यूज़िक माला) - Environment Configuration Example
# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Database Connection (Required for Playlist & Tracks Persistence)
# ------------------------------------------------------------------------------
# MongoDB Atlas or local MongoDB connection URI.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster0.example.mongodb.net/music-maala?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. Google Gemini API (Required for AI Raag & Pahar Lore Enrichment)
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Used in /api/enrich-raags to analyze and classify bhajans into Classical Raags & 8 Pahars.
# By default, starts with high-intelligence Gemini 3.7 Flash and automatically cascades
# down (3.7 Flash -> 3.6 Flash -> 3.5 Flash -> 2.5 Flash) if quota is exceeded.
GEMINI_API_KEY="your_gemini_api_key_here"

# (Optional) Override primary model (defaults to auto-cascading: gemini-3.7-flash)
# GEMINI_MODEL="gemini-3.7-flash"

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 (Required for Admin Playlist Syncing)
# ------------------------------------------------------------------------------
# Get your API key from Google Cloud Console with YouTube Data API v3 enabled:
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Used in /api/sync-playlist to pull video metadata from YouTube playlists.
YOUTUBE_API_KEY="your_youtube_data_api_v3_key_here"

# ------------------------------------------------------------------------------
# 4. Fair Use Admin Authentication Password (Required for securing Gemini API)
# ------------------------------------------------------------------------------
# Set a secret password to prevent unauthorized calls to Gemini AI / sync routes.
PASSWORD="your_admin_password_here"

# ------------------------------------------------------------------------------
# 5. Optional Application Settings
# ------------------------------------------------------------------------------
# Public URL for metadata and canonical URLs in production.
# NEXT_PUBLIC_APP_URL="https://music-maala.vercel.app"
